# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# environment variables
.env
.env.local
.env.production
.env*.local

# content lock files
*.lock
*.tmp

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# security (fallback files — Supabase is the primary store)
# src/data/contact-log.json, totp.json, admin-credentials.json no longer exist
# They were migrated to Supabase (contact_messages, app_settings tables).

# typescript
*.tsbuildinfo
next-env.d.ts

.genkit/*
.env*

# logs
server.log
*.log

# playwright mcp debug artifacts
.playwright-mcp/

# playwright test results
test-results/
playwright-report/

