# Copy this file to .env.local and replace placeholders with your own values.
# Never commit .env.local or any real secret.

# Admin authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password
ADMIN_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Supabase (required for persistent content and messages)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional AI assistant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional email notifications
RESEND_API_KEY=
RESEND_FROM=
RESEND_TO=

# Optional CAPTCHA
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
